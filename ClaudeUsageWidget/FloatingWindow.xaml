<Window x:Class="ClaudeUsageWidgetProvider.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        Title="Token Bars">
  <!-- Margen transparente para que la sombra no se recorte -->
  <Border Margin="14" CornerRadius="16" Padding="1.5" Width="272">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97757" Offset="0"/>
        <GradientStop Color="#7C5CFF" Offset="0.5"/>
        <GradientStop Color="#10A37F" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97757" Offset="0"/>
        <GradientStop Color="#7C5CFF" Offset="0.5"/>
        <GradientStop Color="#10A37F" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Border CornerRadius="15" Padding="14,12,14,12">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F21B1A24" Offset="0"/>
          <GradientStop Color="#F2101016" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>

      <StackPanel>
        <Grid Margin="0,0,0,8">
          <TextBlock Text="TOKEN BARS" FontSize="10" FontWeight="Bold"
                     Foreground="#8A8AA0" VerticalAlignment="Center">
            <TextBlock.Effect>
              <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#7C5CFF" Opacity="0.8"/>
            </TextBlock.Effect>
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="UpdatedText" FontSize="9.5" Foreground="#6E6E85"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6E6E85" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <StackPanel x:Name="ServicesPanel"/>

        <TextBlock x:Name="HintText" Margin="0,8,0,0" FontSize="9" Foreground="#55556A"
                   HorizontalAlignment="Center"
                   Text="Arrastra para mover · doble clic actualiza · clic derecho: menú"/>
      </StackPanel>
    </Border>
  </Border>
</Window>
